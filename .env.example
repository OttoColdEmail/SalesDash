# SalesDash Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001

# ===================
# Facebook Ads API
# ===================
# 1. Go to https://developers.facebook.com/
# 2. Create/use an app with Marketing API
# 3. Get Access Token from Graph API Explorer
# 4. Get Ad Account ID from Business Manager (format: act_XXXXX)

FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_AD_ACCOUNT_ID=act_your_ad_account_id

# ===================
# Calendly API
# ===================
# 1. Go to https://calendly.com/integrations/api_webhooks
# 2. Generate a Personal Access Token
# 3. Create two separate event types for attribution:
#    - One for Facebook Ads traffic
#    - One for Cold Email traffic
# 4. Get the event type URIs from the API

CALENDLY_API_KEY=your_calendly_api_key
CALENDLY_ADS_EVENT_URI=https://api.calendly.com/event_types/your_ads_event_id
CALENDLY_EMAIL_EVENT_URI=https://api.calendly.com/event_types/your_email_event_id

# ===================
# GoHighLevel API
# ===================
# 1. Go to Settings > Business Profile > API Keys
# 2. Generate an API key
# 3. Get Location ID from URL when in sub-account

GHL_API_KEY=your_gohighlevel_api_key
GHL_LOCATION_ID=your_location_id
